# PROPOSED configuration contract; no executable loads this file in the docs foundation.
# Copy to a locally ignored .env only after implementation documents loading behavior.
# Never commit secrets. A key does not itself authorize a live call.
TYPESAFE_API_KEY=
JEV_GOVERNOR_MODE=advisory
JEV_GOVERNOR_JEV_ENABLED=false
# Dated starting version; verify availability and pin deliberately for experiments.
JEV_GOVERNOR_JEV_MODEL=jev-1.13.0
# Zero denies provider attempts. Any live test needs explicit enablement + bounded approval.
JEV_GOVERNOR_LIVE_MAX_ATTEMPTS=0
JEV_GOVERNOR_JEV_TIMEOUT_SECONDS=10
JEV_GOVERNOR_SHARE_RAW_CONTENT=false
# Keep runtime state outside the target agent's writable workspace where practical.
# Choose an OS-appropriate local directory during setup; no shell expansion is implied here.
JEV_GOVERNOR_DATA_DIR=
